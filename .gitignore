# Build artifacts
dist/
build/

# Local reverse-engineering workspace (jadx APK dump, decompiled bundles,
# python-roborock wheel, tooling). Large and not part of the integration.
.analysis/

# Home Assistant local configuration and credentials, in case a real config
# directory is checked out or symlinked alongside the component.
.storage/
secrets.yaml
*.token
cloudflare_token

# Local credential files for the sync scripts. Those scripts read the HA SSH
# password from ROBOROCK_HA_PASSWORD; this covers the case where someone keeps
# it in a file instead. The repository is public.
.env
.env.*
!.env.example
*.credentials

# Certificates and keys
*.pem
*.key
*.crt
*.p12
*.pfx

